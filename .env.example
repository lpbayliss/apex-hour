# Apex Hour environment overrides. Defaults < YAML < environment.
APEX_HOUR__MODE=production
APEX_HOUR__SERVER__PUBLIC_ORIGIN=https://apex-hour.example
APEX_HOUR__SERVER__PORT=3000
APEX_HOUR__SERVER__ALLOWED_ORIGINS=[]
APEX_HOUR__SERVER__TRUSTED_PROXY={"enabled":false,"cidrs":[]}
APEX_HOUR__DATABASE__PATH=/data/apex-hour.sqlite3
APEX_HOUR__BACKUP__DIRECTORY=/backup
APEX_HOUR__CONFIG__FILE=/config/apex-hour.yaml
APEX_HOUR__CONFIG__MAXIMUM_FILE_BYTES=1048576
APEX_HOUR__METRICS__ENABLED=false
# Set only when metrics exposure requires authentication; never commit a real token.
APEX_HOUR__METRICS__BEARER_TOKEN=null
APEX_HOUR__SIMULATION__RACE_INTERVAL_SECONDS=3600
APEX_HOUR__SIMULATION__LIVE_DURATION_SECONDS=2700
APEX_HOUR__PATHS__DATA_ROOT=/data
APEX_HOUR__PATHS__CONFIG_ROOT=/config
APEX_HOUR__PATHS__BACKUP_ROOT=/backup
APEX_HOUR__PATHS__ALLOW_OUTSIDE_ROOTS_IN_DEVELOPMENT=false
